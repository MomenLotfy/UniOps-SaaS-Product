# ── docker-compose.override.yml ─────────────────────────────────────────────────
# Copy to docker-compose.override.yml if Docker Hub is blocked in your region.
# This file makes Docker use a faster/available mirror instead of hub.docker.com.
#
# Usage:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up --build
#
# Common mirrors:
#   - mirror.gcr.io      (Google)
#   - registry.cn-hangzhou.aliyuncs.com  (Alibaba — China)
#   - docker.mirrors.ustc.edu.cn         (USTC — China)
#
# Alternatively, configure Docker daemon globally:
#   Edit /etc/docker/daemon.json (Linux) or Docker Desktop > Settings > Docker Engine:
#   {
#     "registry-mirrors": ["https://mirror.gcr.io"]
#   }
#   Then restart Docker.

services:
  db:
    image: mirror.gcr.io/library/postgres:16-alpine

  redis:
    image: mirror.gcr.io/library/redis:7-alpine

  backend:
    build:
      args:
        - BUILDKIT_INLINE_CACHE=1

  frontend:
    build:
      args:
        - BUILDKIT_INLINE_CACHE=1

  prometheus:
    image: mirror.gcr.io/prom/prometheus:latest

  grafana:
    image: mirror.gcr.io/grafana/grafana:latest
