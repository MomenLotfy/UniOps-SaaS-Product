modules = ["nodejs-24", "python-3.11", "python3"]
[nix]
channel = "stable-25_05"
packages = ["cargo", "glibcLocales", "libiconv", "libxcrypt", "openssl", "pkg-config", "postgresql", "rustc"]

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/uniops run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && /home/runner/workspace/.pythonlibs/bin/uvicorn app.main:app --host 0.0.0.0 --port 3001 --reload"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "git log --oneline -10"
mode = "sequential"
author = 57818029

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git log --oneline -10"

[[workflows.workflow]]
name = "git push origin main"
mode = "sequential"
author = 57818029

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git push origin main "

[[workflows.workflow]]
name = "Fetch"
mode = "sequential"
author = 57818029

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git fetch origin git status git log --oneline --decorate --graph --all -20"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
APP_ENV = "development"
DEBUG = "true"
SECRET_KEY = "uniops-replit-dev-secret-key-change-in-prod"
JWT_SECRET_KEY = "uniops-jwt-secret-key-change-in-prod"
FRONTEND_URL = "http://localhost:5000"
CORS_ORIGINS = "[\"*\"]"
ENABLE_METRICS = "false"
