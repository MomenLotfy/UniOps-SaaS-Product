modules = ["python-3.11", "nodejs-20", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["cargo", "glibcLocales", "libiconv", "libxcrypt", "openssl", "pkg-config", "postgresql", "rustc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Redis Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Celery Worker"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Celery Beat"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 3001"
waitForPort = 3001

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 pnpm --filter @workspace/uniops run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Redis Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --port 6379 --loglevel notice"
waitForPort = 6379

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Celery Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && until redis-cli -p 6379 ping 2>/dev/null | grep -q PONG; do sleep 2; done && venv/bin/celery -A app.core.celery_app worker --loglevel=info -c 2"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Celery Beat"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && until redis-cli -p 6379 ping 2>/dev/null | grep -q PONG; do sleep 2; done && venv/bin/celery -A app.core.celery_app beat --loglevel=info"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6379
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 5000"]
build = ["pnpm", "--filter", "@workspace/uniops", "run", "build"]

[userenv]

[userenv.shared]
APP_ENV = "development"
DEBUG = "true"
SECRET_KEY = "k4Qwg2ys9ius4sdqhA7gdZYqJZ_TqbmztPt811MYwLCL5axTkF5oIiybWQaCUfYV"
JWT_SECRET_KEY = "k4Qwg2ys9ius4sdqhA7gdZYqJZ_TqbmztPt811MYwLCL5axTkF5oIiybWQaCUfYV"
REDIS_URL = "redis://localhost:6379/0"
CELERY_BROKER_URL = "redis://localhost:6379/1"
CELERY_RESULT_BACKEND = "redis://localhost:6379/2"
LOG_LEVEL = "INFO"
LOG_FORMAT = "text"
OTEL_SDK_DISABLED = "true"
RATE_LIMIT_ENABLED = "false"
