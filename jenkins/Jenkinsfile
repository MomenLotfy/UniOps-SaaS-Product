// jenkins/Jenkinsfile
// UniOps Control Tower - CI/CD Pipeline
// Uses: AWS ECR + kubectl (EKS) — No DockerHub, No Ansible

pipeline {
    agent any

    environment {
        // AWS & ECR
        AWS_REGION        = 'us-east-2'
        AWS_ACCOUNT_ID    = '663476173962'
        ECR_BACKEND       = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/uniops-backend"
        ECR_FRONTEND      = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/uniops-frontend"

        // EKS
        EKS_CLUSTER       = 'uniops-eks-dev'
        K8S_NAMESPACE     = 'uniops'

        // SonarQube
        SONAR_HOST_URL    = 'http://172.17.0.1:9000'
        SONAR_PROJECT_KEY = 'uniops'

        // Trivy
        TRIVY_SEVERITY    = 'HIGH,CRITICAL'

        // Slack
        SLACK_CHANNEL     = '#uniops-ci'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
    }

    stages {

        // ─── 1. Checkout ──────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/MomenLotfy/UniOps-SaaS-Product.git',
                        credentialsId: 'github-creds'
                    ]]
                ])
                script {
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.GIT_BRANCH       = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
                    env.BUILD_TAG        = "${env.GIT_BRANCH}-${env.GIT_COMMIT_SHORT}-${env.BUILD_NUMBER}"
                }
                echo "📦 Building: ${env.BUILD_TAG}"
            }
        }

        // ─── 2. DevSecOps Scans (متوازي) ─────────────────────
        stage('DevSecOps Scans') {
            parallel {
                stage('SonarQube') {
                    steps {
                        withSonarQubeEnv('SonarQube') {
                            sh '''
                                echo "🔍 SonarQube SAST + Code Quality"
                                sonar-scanner \
                                    -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                    -Dsonar.sources=./backend,./artifacts/uniops/src \
                                    -Dsonar.host.url=${SONAR_HOST_URL}
                            '''
                        }
                    }
                }
                stage('Trivy FS') {
                    steps {
                        sh '''
                            echo "🔒 Trivy Filesystem Scan"
                            trivy fs --severity ${TRIVY_SEVERITY} --exit-code 0 --format sarif -o trivy-fs.sarif ./
                        '''
                    }
                }
                stage('Semgrep') {
                    steps {
                        sh '''
                            echo "🕵️ Semgrep Secrets Detection"
                            semgrep --config=auto --error --metrics=off
                        '''
                    }
                }
            }
        }

        // ─── 3. Build & Unit Tests ────────────────────────────
        stage('Build & Test') {
            parallel {
                stage('Frontend') {
                    steps {
                        sh '''
                            cd artifacts/uniops
                            pnpm install --frozen-lockfile
                            pnpm run typecheck
                            pnpm test --run || true
                        '''
                    }
                }
                stage('Backend') {
                    steps {
                        sh '''
                            cd backend
                            pip install -r requirements.txt
                            python -m pytest tests/ -v --tb=short
                        '''
                    }
                }
            }
        }

        // ─── 4. Build Docker Images ───────────────────────────
        stage('Build Docker Images') {
            steps {
                sh '''
                    echo "🐳 Building Frontend Image"
                    docker build -t ${ECR_FRONTEND}:${BUILD_TAG} -t ${ECR_FRONTEND}:latest \
                        -f artifacts/uniops/Dockerfile artifacts/uniops/

                    echo "🐳 Building Backend Image"
                    docker build -t ${ECR_BACKEND}:${BUILD_TAG} -t ${ECR_BACKEND}:latest \
                        -f backend/Dockerfile backend/
                '''
            }
        }

        // ─── 5. Container Security Scan (Trivy) ──────────────
        stage('Container Security') {
            steps {
                sh '''
                    echo "🔒 Scanning Frontend Image"
                    trivy image --severity ${TRIVY_SEVERITY} --exit-code 1 ${ECR_FRONTEND}:${BUILD_TAG}
                    echo "🔒 Scanning Backend Image"
                    trivy image --severity ${TRIVY_SEVERITY} --exit-code 1 ${ECR_BACKEND}:${BUILD_TAG}
                '''
            }
        }

        // ─── 6. Push to ECR ───────────────────────────────────
        stage('Push to ECR') {
            when { branch 'main' }
            steps {
                withAWS(credentials: 'aws-ecr-creds', region: "${AWS_REGION}") {
                    sh '''
                        echo "🔑 Logging in to ECR"
                        aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login --username AWS --password-stdin \
                            ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                        echo "📤 Pushing Frontend"
                        docker push ${ECR_FRONTEND}:${BUILD_TAG}
                        docker push ${ECR_FRONTEND}:latest

                        echo "📤 Pushing Backend"
                        docker push ${ECR_BACKEND}:${BUILD_TAG}
                        docker push ${ECR_BACKEND}:latest
                    '''
                }
            }
        }

        // ─── 7. Deploy to EKS (Dev) ───────────────────────────
        stage('Deploy to EKS Dev') {
            when { branch 'main' }
            steps {
                withKubeCredentials([[
                    credentialsId: 'eks-jenkins-token',
                    serverUrl: 'https://450B0E6A13174336E007089BA22A382E.gr7.us-east-2.eks.amazonaws.com',
                    namespace: "${K8S_NAMESPACE}"
                ]]) {
                    sh '''
                        echo "🚀 Deploying to EKS Dev Namespace: ${K8S_NAMESPACE}"

                        # Update image tags in manifests
                        kubectl set image deployment/backend \
                            backend=${ECR_BACKEND}:${BUILD_TAG} \
                            -n ${K8S_NAMESPACE}

                        kubectl set image deployment/frontend \
                            frontend=${ECR_FRONTEND}:${BUILD_TAG} \
                            -n ${K8S_NAMESPACE}

                        # Wait for rollout
                        kubectl rollout status deployment/backend -n ${K8S_NAMESPACE} --timeout=120s
                        kubectl rollout status deployment/frontend -n ${K8S_NAMESPACE} --timeout=120s
                    '''
                }
            }
        }

        // ─── 8. Health Check ──────────────────────────────────
        stage('Health Check') {
            when { branch 'main' }
            steps {
                withKubeCredentials([[
                    credentialsId: 'eks-jenkins-token',
                    serverUrl: 'https://450B0E6A13174336E007089BA22A382E.gr7.us-east-2.eks.amazonaws.com',
                    namespace: "${K8S_NAMESPACE}"
                ]]) {
                    sh '''
                        echo "🏥 Checking Pod Status"
                        kubectl get pods -n ${K8S_NAMESPACE}
                        kubectl wait --for=condition=ready pod \
                            -l app=backend -n ${K8S_NAMESPACE} --timeout=120s
                        kubectl wait --for=condition=ready pod \
                            -l app=frontend -n ${K8S_NAMESPACE} --timeout=120s
                        echo "✅ All pods are healthy"
                    '''
                }
            }
        }

        // ─── 9. Deploy to Production (موافقة يدوية) ──────────
        stage('Deploy to Production') {
            when { branch 'main' }
            input {
                message "🚀 Deploy to Production?"
                ok "Release"
                submitter "admin,devops-lead"
            }
            steps {
                withKubeCredentials([[
                    credentialsId: 'eks-jenkins-token',
                    serverUrl: 'https://450B0E6A13174336E007089BA22A382E.gr7.us-east-2.eks.amazonaws.com',
                    namespace: 'uniops-prod'
                ]]) {
                    sh '''
                        echo "🚀 Deploying to Production"
                        kubectl set image deployment/backend \
                            backend=${ECR_BACKEND}:${BUILD_TAG} \
                            -n uniops-prod

                        kubectl set image deployment/frontend \
                            frontend=${ECR_FRONTEND}:${BUILD_TAG} \
                            -n uniops-prod

                        kubectl rollout status deployment/backend -n uniops-prod --timeout=180s
                        kubectl rollout status deployment/frontend -n uniops-prod --timeout=180s
                    '''
                }
            }
        }

        // ─── 10. Post-Deploy Verification ─────────────────────
        stage('Post-Deploy Verification') {
            when { branch 'main' }
            steps {
                withKubeCredentials([[
                    credentialsId: 'eks-jenkins-token',
                    serverUrl: 'https://450B0E6A13174336E007089BA22A382E.gr7.us-east-2.eks.amazonaws.com',
                    namespace: 'uniops-prod'
                ]]) {
                    sh '''
                        echo "✅ Verifying Production"
                        kubectl get pods -n uniops-prod
                        kubectl wait --for=condition=ready pod \
                            -l app=backend -n uniops-prod --timeout=180s
                        kubectl wait --for=condition=ready pod \
                            -l app=frontend -n uniops-prod --timeout=180s
                    '''
                }
            }
        }
    }

    post {
        success {
            slackSend(
                channel: SLACK_CHANNEL,
                color: 'good',
                message: "✅ UniOps #${BUILD_NUMBER} SUCCESS\n📦 ${env.BUILD_TAG}\n🔗 ${env.BUILD_URL}"
            )
        }
        failure {
            slackSend(
                channel: SLACK_CHANNEL,
                color: 'danger',
                message: "❌ UniOps #${BUILD_NUMBER} FAILED\n📦 ${env.BUILD_TAG}\n🔗 ${env.BUILD_URL}"
            )
        }
        always {
            cleanWs()
        }
    }
}
