# ─── UniOps Control Tower — Unified Environment Reference ──────────────────────
#
# This file documents ALL environment variables used across every runtime.
# See backend/.env.example for the full backend-specific reference.
#
# ┌─────────────────┬───────────────────────────────────────────────────────┐
# │ Runtime         │ Which .env file to use                                │
# ├─────────────────┼───────────────────────────────────────────────────────┤
# │ Docker Compose  │ backend/.env.docker  (service names: db, redis)       │
# │ Local dev       │ backend/.env.local   (sqlite + localhost redis)       │
# │ Replit          │ backend/.env         (sqlite + localhost)             │
# │ Production VPS  │ system env vars / secrets manager                     │
# └─────────────────┴───────────────────────────────────────────────────────┘
#
# CRITICAL NETWORKING RULE:
#   Inside Docker containers → use service names (db, redis, backend)
#   Outside Docker (Replit, bare metal) → use localhost or your server IP
# ───────────────────────────────────────────────────────────────────────────────

# Copy the right file for your environment:
#   Docker:  already configured in backend/.env.docker
#   Local:   cd backend && cp .env.local .env
#   Replit:  already configured in backend/.env

# ─── Minimal required vars (production VPS) ─────────────────────────────────────
APP_ENV=production
SECRET_KEY=CHANGE_ME_32chars_min
JWT_SECRET_KEY=CHANGE_ME_32chars_min
DATABASE_URL=postgresql+asyncpg://user:pass@your-host:5432/uniops_db
REDIS_URL=redis://your-redis-host:6379/0
CELERY_BROKER_URL=redis://your-redis-host:6379/1
CELERY_RESULT_BACKEND=redis://your-redis-host:6379/2
CORS_ORIGINS=["https://your-domain.com"]
FRONTEND_URL=https://your-domain.com
