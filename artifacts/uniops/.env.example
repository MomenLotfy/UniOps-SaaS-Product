# UniOps Frontend — Environment Variables
# Copy this file to .env.local and adjust if needed

# FastAPI backend base URL — includes /api/v1 prefix
# In dev, Vite proxies /api/v1/* → http://localhost:8000/api/v1/*
# Override only if your backend runs on a different host/port
# VITE_API_URL=http://localhost:8000/api/v1

# WebSocket URL — auto-detected from window.location in dev
# Override for custom WS host:
# VITE_WS_URL=ws://localhost:8000
