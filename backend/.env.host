CORS_ORIGINS=["http://localhost:5000","http://localhost:5173","http://localhost:3000","http://localhost:80","http://localhost","http://127.0.0.1:5000","http://127.0.0.1:5173","http://0.0.0.0:5000"]

AWS_ACCESS_KEY_ID=
