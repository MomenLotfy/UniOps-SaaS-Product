# ─── App ───────────────────────────────────────────────────────────────────────
APP_NAME=UniOps
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173

# ─── Security ──────────────────────────────────────────────────────────────────
# Auto-generated by: make setup
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://uniops:uniops_password@db:5432/uniops_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── AWS (optional — leave empty to use demo data) ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── GitHub (optional — leave empty to use demo data) ──────────────────────────
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ─── GitLab (optional) ─────────────────────────────────────────────────────────
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# ─── Stripe (optional — billing disabled if empty) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ─── Email (optional — invite emails disabled if empty) ────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@uniops.io

# ─── Slack (optional) ──────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# ─── SonarQube (optional — falls back to Semgrep if empty) ────────────────────
SONARQUBE_URL=
SONARQUBE_TOKEN=

# ─── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
RATE_LIMIT_PER_MINUTE=120
