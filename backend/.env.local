# ── Local Development — no Docker, no PostgreSQL, no Redis needed ──────────────
APP_NAME=UniOps
APP_ENV=development
DEBUG=true

# SQLite (zero setup needed)
DATABASE_URL=sqlite+aiosqlite:///./uniops_dev.db

# Dummy Redis (won't be used without Celery)
redis://redis:6379
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security (dev only — change in production)
SECRET_KEY=dev-secret-key-32chars-change-me
JWT_SECRET_KEY=dev-jwt-key-32chars-change-me-xx
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend URL
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional — leave empty for local dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GITHUB_TOKEN=
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=
SLACK_BOT_TOKEN=
