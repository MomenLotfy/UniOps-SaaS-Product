# ── Local Development (no Docker, no PostgreSQL, no Redis needed) ─────────────
# Uses SQLite for DB. Celery tasks won't run (no Redis), but FastAPI works fine.
# Usage: cd backend && cp .env.local .env && python -m uvicorn app.main:app --reload
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=UniOps
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# SQLite — zero setup needed
DATABASE_URL=sqlite+aiosqlite:///./uniops_dev.db

# Redis — optional for local dev (Celery tasks disabled if Redis unavailable)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security (dev only — change in production)
SECRET_KEY=dev-secret-key-32chars-change-me
JWT_SECRET_KEY=dev-jwt-key-32chars-change-me-xx
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend URL
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5000"]

# Optional integrations — leave empty for local dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
GITHUB_TOKEN=
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=
SLACK_BOT_TOKEN=
SENTRY_DSN=
