# ── Docker Compose environment ───────────────────────────────────────────────
# Used by docker-compose.yml via: env_file: ./backend/.env.docker
#
# RULE: Service-to-service URLs use Docker DNS names, NOT localhost.
#   db    → PostgreSQL container
#   redis → Redis container
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=UniOps
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Frontend URL — used for CORS and email links
# In Docker, nginx serves on port 80
FRONTEND_URL=http://localhost:80

# ── Security ─────────────────────────────────────────────────────────────────
# Generate fresh values with: openssl rand -hex 32
SECRET_KEY=uniops-secret-key-docker-2025-change-in-production-abc123
JWT_SECRET_KEY=uniops-jwt-secret-key-docker-2025-change-in-production-xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL — Docker DNS: "db" resolves to the db container ───────────────
DATABASE_URL=postgresql+asyncpg://uniops:uniops_password@db:5432/uniops_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis — Docker DNS: "redis" resolves to the redis container ──────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── CORS — allow frontend origins ────────────────────────────────────────────
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000","http://127.0.0.1","http://127.0.0.1:80"]

# ── AWS (optional — leave empty to use demo data) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── GitHub (optional — leave empty to use demo data) ─────────────────────────
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── GitLab (optional) ────────────────────────────────────────────────────────
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# ── Stripe (optional — billing disabled if empty) ────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Email (optional — invite emails disabled if empty) ───────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@uniops.io

# ── Slack (optional) ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# ── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=
RATE_LIMIT_PER_MINUTE=120
ENABLE_METRICS=false
