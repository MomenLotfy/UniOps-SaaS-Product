# ── Replit environment ────────────────────────────────────────────────────────
# This file is used when running directly in Replit (no Docker).
# All services run on the same host, so localhost is correct here.
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=UniOps
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5000

SECRET_KEY=k4Qwg2ys9ius4sdqhA7gdZYqJZ_TqbmztPt811MYwLCL5axTkF5oIiybWQaCUfYV
JWT_SECRET_KEY=k4Qwg2ys9ius4sdqhA7gdZYqJZ_TqbmztPt811MYwLCL5axTkF5oIiybWQaCUfYV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# SQLite — no PostgreSQL needed in Replit
DATABASE_URL=sqlite+aiosqlite:///./uniops_dev.db

# Redis — not available in Replit; Celery tasks won't run (scheduler covers it)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CORS_ORIGINS=["*"]

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
GITHUB_TOKEN=
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=
SLACK_BOT_TOKEN=
SENTRY_DSN=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ENABLED=false
OTEL_SDK_DISABLED=true
